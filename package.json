{
  "name": "@xtrape/linux-ops-widget",
  "version": "0.8.7",
  "description": "Linux Ops Widget: controlled Linux host operations published as an Xtrape Service.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://forgejo.xtrape.com/xtrape-project/linux-ops-widget-nodejs.git"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "bin": {
    "linux-ops-widget": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@xtrape/connector": "^0.8.7",
    "@xtrape/contracts": "^0.8.17",
    "ajv": "^8.17.1",
    "better-sqlite3": "^13.0.3",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.0",
    "eslint": "^9.20.0",
    "secretlint": "13.0.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "ssh2"
    ],
    "overrides": {
      "fast-uri@<3.1.7": "^3.1.7"
    }
  },
  "homepage": "https://forgejo.xtrape.com/xtrape-project/linux-ops-widget-nodejs#readme",
  "bugs": {
    "url": "https://forgejo.xtrape.com/xtrape-project/linux-ops-widget-nodejs/issues"
  }
}
